    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.8",
    "@colyseus/ws-transport": "^0.18.4",
    "@lw/shared": "^0.1.0"
  }
}
